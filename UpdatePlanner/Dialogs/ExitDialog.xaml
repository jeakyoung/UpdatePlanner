<Window x:Class="UpdatePlanner.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="종료 옵션" Width="400" Height="175"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtMessage"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   FontSize="13"
                   LineHeight="20"
                   Text="프로그램을 완전히 종료하거나 백그라운드로 전환할 수 있습니다."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnBackground" Content="백그라운드 시행"
                    Width="120" Height="30" Margin="0,0,8,0"
                    Click="BtnBackground_Click"/>
            <Button x:Name="BtnExit" Content="완전 종료"
                    Width="90" Height="30" Margin="0,0,8,0"
                    Click="BtnExit_Click"/>
            <Button Content="취소"
                    Width="60" Height="30"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
