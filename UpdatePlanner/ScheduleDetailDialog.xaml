<Window x:Class="UpdatePlanner.ScheduleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="예약 상세 설정" Width="480" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 시작 일시 ── -->
        <GroupBox Grid.Row="0" Header="시작 일시">
            <StackPanel Orientation="Horizontal">
                <DatePicker x:Name="StartDate" Width="148" VerticalAlignment="Center"
                            ToolTip="반복인 경우 이 날짜 이후부터 실행됩니다"/>
                <TextBlock Text="  시간 " VerticalAlignment="Center" Foreground="#FF444444"/>
                <TextBox x:Name="TxtStartHour" Width="32" MaxLength="2"
                         PreviewTextInput="TimeBox_PreviewTextInput"
                         LostFocus="TxtStartHour_LostFocus"/>
                <TextBlock Text=":" VerticalAlignment="Center"
                           FontSize="16" FontWeight="Bold" Margin="4,0"/>
                <TextBox x:Name="TxtStartMinute" Width="32" MaxLength="2"
                         PreviewTextInput="TimeBox_PreviewTextInput"
                         LostFocus="TxtStartMinute_LostFocus"/>
            </StackPanel>
        </GroupBox>

        <!-- ── 종료 일시 (선택) ── -->
        <GroupBox Grid.Row="1" Header="종료 일시 (선택 — 반복 시 적용)">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbNoEnd" Content="지정 안 함" IsChecked="True"
                             Margin="0,0,18,0" Checked="RbEndMode_Checked"/>
                <RadioButton x:Name="RbEndDate" Content="날짜 지정 :"
                             Margin="0,0,8,0"   Checked="RbEndMode_Checked"/>
                <DatePicker x:Name="EndDate" Width="148" IsEnabled="False" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- ── 반복 주기 ── -->
        <GroupBox Grid.Row="2" Header="반복 주기">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbNone"    Content="반복 없음 (1회)" IsChecked="True"
                             Margin="0,0,24,0" Checked="RbRepeat_Checked"/>
                <RadioButton x:Name="RbWeekly"  Content="매주"
                             Margin="0,0,24,0" Checked="RbRepeat_Checked"/>
                <RadioButton x:Name="RbMonthly" Content="매달"
                             Checked="RbRepeat_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- ── 반복 상세 ── -->
        <Border Grid.Row="3" BorderBrush="#FFD4D4D4" BorderThickness="1"
                CornerRadius="3" Padding="10,8" MinHeight="64" Margin="0,0,0,8">
            <Grid>
                <!-- 반복 없음 -->
                <TextBlock x:Name="PanelNone"
                           Text="반복 없이 시작 일시에 1회 실행합니다."
                           Foreground="#FF888888" VerticalAlignment="Center"/>

                <!-- 매주 -->
                <StackPanel x:Name="PanelWeekly" Visibility="Collapsed">
                    <TextBlock Text="실행할 요일을 선택하세요:"
                               Foreground="#FF555555" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkMon" Content="월" Width="48"/>
                        <CheckBox x:Name="ChkTue" Content="화" Width="48"/>
                        <CheckBox x:Name="ChkWed" Content="수" Width="48"/>
                        <CheckBox x:Name="ChkThu" Content="목" Width="48"/>
                        <CheckBox x:Name="ChkFri" Content="금" Width="48"/>
                        <CheckBox x:Name="ChkSat" Content="토" Width="48"
                                  Foreground="#FF0055BB"/>
                        <CheckBox x:Name="ChkSun" Content="일"
                                  Foreground="#FFBB2222"/>
                    </StackPanel>
                </StackPanel>

                <!-- 매달 -->
                <StackPanel x:Name="PanelMonthly" Visibility="Collapsed">
                    <TextBlock Text="실행할 일자를 선택하세요 (복수 선택 가능):"
                               Foreground="#FF555555" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="WrapMonthDays"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 버튼 ── -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Width="70" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="취소" Width="60"
                    IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
