<Window x:Class="UpdatePlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Planner" Height="620" Width="720"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FTP 서버 설정 -->
        <GroupBox Grid.Row="0" Header="FTP 서버 설정">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="호스트:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHost" ToolTip="FTP 서버 주소 (예: ftp.example.com)"/>
                <Label Grid.Row="0" Grid.Column="2" Content="포트:" HorizontalAlignment="Right" Margin="4,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtPort" Text="21" ToolTip="FTP 포트 번호 (기본값: 21)"/>

                <Label Grid.Row="2" Grid.Column="0" Content="사용자:"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtUsername" ToolTip="FTP 계정 아이디"/>
                <Label Grid.Row="2" Grid.Column="2" Content="비밀번호:" HorizontalAlignment="Right" Margin="4,0,4,0"/>
                <PasswordBox Grid.Row="2" Grid.Column="3" x:Name="TxtPassword" ToolTip="FTP 계정 비밀번호"/>

                <Label Grid.Row="4" Grid.Column="0" Content="FTP 경로:"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtFtpPath"
                         ToolTip="다운로드할 FTP 경로 (예: /uploads/update)"/>
                <Button Grid.Row="4" Grid.Column="3" Content="연결 테스트" Margin="4,0,0,0"
                        x:Name="BtnTest" Click="BtnTest_Click" ToolTip="FTP 서버 연결을 테스트합니다"/>
            </Grid>
        </GroupBox>

        <!-- 로컬 설정 -->
        <GroupBox Grid.Row="1" Header="로컬 설정">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="대상 폴더:"/>
                <TextBox Grid.Column="1" x:Name="TxtLocalPath" ToolTip="파일을 저장할 로컬 폴더 경로"/>
                <Button Grid.Column="2" Content="찾아보기" Margin="6,0,0,0"
                        Click="BtnBrowse_Click" ToolTip="폴더를 선택합니다"/>
            </Grid>
        </GroupBox>

        <!-- 업데이트 예약 -->
        <GroupBox Grid.Row="2" Header="업데이트 예약">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="예약 날짜:"/>
                <DatePicker Grid.Row="0" Grid.Column="1" x:Name="DateSchedule"
                            VerticalAlignment="Center" Height="26"
                            ToolTip="업데이트를 실행할 날짜"/>
                <Label Grid.Row="0" Grid.Column="2" Content="시간:" HorizontalAlignment="Right" Margin="4,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="TxtTime" Text="00:00"
                         ToolTip="업데이트 시간 (HH:mm 형식, 예: 03:00)"/>
                <Button Grid.Row="0" Grid.Column="5" x:Name="BtnStart" Content="예약 시작"
                        Click="BtnStart_Click" Margin="4,0,0,0"
                        Background="#FF4CAF50" Foreground="White" FontWeight="Bold"
                        ToolTip="지정한 시간에 FTP 업데이트를 실행하도록 예약합니다"/>
                <Button Grid.Row="0" Grid.Column="6" x:Name="BtnCancel" Content="예약 취소"
                        Click="BtnCancel_Click" Margin="6,0,0,0"
                        IsEnabled="False" ToolTip="예약을 취소합니다"/>

                <Label Grid.Row="2" Grid.Column="0" Content="즉시 실행:" Foreground="Gray"/>
                <Button Grid.Row="2" Grid.Column="1" x:Name="BtnRunNow" Content="지금 바로 실행"
                        HorizontalAlignment="Left" Padding="12,4"
                        Click="BtnRunNow_Click"
                        ToolTip="예약 없이 즉시 FTP 업데이트를 실행합니다"/>
            </Grid>
        </GroupBox>

        <!-- 상태 표시 -->
        <GroupBox Grid.Row="3" Header="상태">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="대기 중"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#FF333333"/>
                    <TextBlock x:Name="TxtCountdown" Text=""
                               FontSize="12" Foreground="#FF0078D7"
                               FontFamily="Consolas" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="로그 지우기"
                        VerticalAlignment="Center"
                        Click="BtnClearLog_Click" Padding="8,4"/>
            </Grid>
        </GroupBox>

        <!-- 실행 로그 -->
        <GroupBox Grid.Row="4" Header="실행 로그">
            <TextBox x:Name="TxtLog"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="11"
                     Background="#FF1E1E1E"
                     Foreground="#FFD4D4D4"
                     BorderThickness="0"
                     Padding="6"/>
        </GroupBox>
    </Grid>
</Window>
